<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Codex CLI Windows Setup</title>
<style>
/* Layout: sticky step rail on the left, single reading column; rail folds to a top strip on narrow screens. System fonts only (offline, locked-down laptops). */
:root {
  --bg: #f6f8fb;
  --surface: #ffffff;
  --fg: #18202d;
  --muted: #586579;
  --rule: #d9dfe8;
  --code-bg: #eaeef4;
  --accent: #1d5ca6;
  --accent-soft: #e2ecf8;
  --warn: #8a5a00;
  --warn-bg: #fdf3dc;
  --warn-rule: #e8c36a;
  --danger: #a32222;
  --ok: #1d7a43;
  --ok-bg: #e3f3e9;
  --tip-bg: #1f2735;
  --tip-fg: #eef2f7;
  --font-body: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-head: "Segoe UI Semibold", "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
  --font-mono: "Cascadia Mono", "Cascadia Code", Consolas, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #11151c; --surface: #181d26; --fg: #e3e8ef; --muted: #9aa6b8; --rule: #2b3340;
    --code-bg: #1e2531; --accent: #82b2ec; --accent-soft: #1d2a3d;
    --warn: #f0c46a; --warn-bg: #2b2414; --warn-rule: #6e5520;
    --danger: #f08b82; --ok: #6fcf97; --ok-bg: #16291e; --tip-bg: #e8edf4; --tip-fg: #151b24;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #11151c; --surface: #181d26; --fg: #e3e8ef; --muted: #9aa6b8; --rule: #2b3340;
  --code-bg: #1e2531; --accent: #82b2ec; --accent-soft: #1d2a3d;
  --warn: #f0c46a; --warn-bg: #2b2414; --warn-rule: #6e5520;
  --danger: #f08b82; --ok: #6fcf97; --ok-bg: #16291e; --tip-bg: #e8edf4; --tip-fg: #151b24;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 17px; line-height: 1.6; }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
a { color: var(--accent); }
a:focus-visible, button:focus-visible, input:focus-visible, .tip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.wrap {
  display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px;
  max-width: 1140px; margin: 0 auto;
  padding-block: 40px 80px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
nav.rail { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 24px); align-self: start; font-size: 15px; }
.rail h2 { font: 600 12px var(--font-body); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 0 0 10px; }
.rail ol { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 2px; }
.rail a { display: flex; gap: 10px; align-items: baseline; padding: 6px 10px; border-radius: 6px; text-decoration: none; color: var(--fg); }
.rail a:hover { background: var(--accent-soft); }
.rail .n { font-family: var(--font-mono); font-size: 13px; color: var(--muted); min-width: 1.6em; font-variant-numeric: tabular-nums; }
.rail li.done a { color: var(--muted); }
.rail li.done .n { color: var(--ok); }
.progress { font-size: 14px; color: var(--muted); margin: 0 0 8px; font-variant-numeric: tabular-nums; }
.bar { height: 4px; background: var(--rule); border-radius: 2px; overflow: hidden; margin-bottom: 24px; }
.bar span { display: block; height: 100%; width: 0; background: var(--ok); transition: width .25s; }

main { min-width: 0; max-width: 800px; }
h1, h2, h3 { font-family: var(--font-head); font-weight: 600; text-wrap: balance; line-height: 1.25; }
h1 { font-size: 2.1rem; margin: 0 0 8px; }
.lede { color: var(--muted); font-size: 1.05rem; margin: 0 0 12px; max-width: 62ch; }
.draft { display: inline-block; font-size: 13px; color: var(--warn); background: var(--warn-bg); border: 1px solid var(--warn-rule); border-radius: 99px; padding: 2px 12px; margin-bottom: 8px; }

section.step { padding-top: 36px; margin-top: 36px; border-top: 1px solid var(--rule); scroll-margin-top: 16px; }
section.step:first-of-type { border-top: 0; margin-top: 12px; }
.step-head { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; margin-bottom: 8px; }
.step-num { font-family: var(--font-mono); font-size: 15px; color: var(--accent); font-weight: 600; }
.step h2 { font-size: 1.5rem; margin: 0; }
.step h3 { font-size: 1.05rem; margin: 24px 0 6px; }
p, li { max-width: 66ch; }
ul.check, ol.plain { padding-left: 1.3em; margin: 8px 0; }
ul.check li, ol.plain li { margin: 4px 0; }

code { font-family: var(--font-mono); font-size: .88em; background: var(--code-bg); padding: 1px 5px; border-radius: 4px; }
.codebox { position: relative; margin: 10px 0 14px; }
.codebox .label { font: 600 12px var(--font-body); letter-spacing: .05em; color: var(--muted); padding: 0 0 4px 2px; }
pre { margin: 0; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; padding-right: 76px; overflow-x: auto; font-size: 15px; line-height: 1.55; }
pre code { background: none; padding: 0; font-size: inherit; }
.cm { color: var(--muted); }
.verify .label { color: var(--ok); }
.verify pre { border-left: 3px solid var(--ok); }
.copy {
  position: absolute; right: 8px; bottom: 8px;
  font: 600 12px var(--font-body); background: var(--surface); color: var(--fg);
  border: 1px solid var(--rule); border-radius: 6px; padding: 4px 10px; cursor: pointer;
}
.copy:hover { border-color: var(--accent); color: var(--accent); }

/* Tooltips: hover or focus to read, click to pin */
.tip {
  position: relative; display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%; margin-left: 4px; vertical-align: 2px;
  border: 1px solid var(--accent); color: var(--accent); background: var(--surface);
  font: 700 12px var(--font-body); cursor: help; user-select: none;
}
.tip-body {
  display: none; position: absolute; top: calc(100% + 8px); left: 0; z-index: 20;
  width: min(340px, 84vw); padding: 12px 14px; border-radius: 8px;
  background: var(--tip-bg); color: var(--tip-fg);
  font: 400 14px/1.5 var(--font-body); text-align: left; cursor: auto; user-select: text;
  box-shadow: 0 8px 24px rgba(0,0,0,.18);
}
.tip-body code { background: rgba(127,127,127,.25); color: inherit; }
.tip:hover .tip-body, .tip:focus .tip-body, .tip.open .tip-body { display: block; }

/* Token form */
.field { display: grid; gap: 4px; margin: 10px 0 18px; max-width: 520px; }
.field label { font-weight: 600; font-size: 15px; }
.field .row { display: flex; gap: 8px; }
.field input {
  flex: 1; min-width: 0; font: 15px var(--font-mono); padding: 9px 12px;
  border: 1px solid var(--rule); border-radius: 8px; background: var(--surface); color: var(--fg);
}
.field input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
.field input.filled { border-color: var(--ok); }
.btn {
  font: 600 14px var(--font-body); padding: 8px 14px; border-radius: 8px; cursor: pointer;
  border: 1px solid var(--rule); background: var(--surface); color: var(--fg);
}
.btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--surface); }
.btn.primary:hover:not(:disabled) { color: var(--surface); filter: brightness(1.08); }
.privacy { font-size: 14px; color: var(--muted); }

.token-block { border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); padding: 4px 18px 6px; margin: 14px 0; }
.token-block h3 { margin-top: 14px; }

/* Model table */
.tablebox { overflow-x: auto; margin: 10px 0 14px; }
table { border-collapse: collapse; width: 100%; font-size: 15px; }
th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
th { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }

/* Files */
.files { display: grid; gap: 10px; margin: 14px 0; }
.file { border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); padding: 12px 16px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; align-items: center; }
.file .fname { font: 600 15px var(--font-mono); }
.file .dest { font: 13px var(--font-mono); color: var(--muted); margin-left: 8px; }
.file .what { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
.file .actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.file .btn { padding: 6px 12px; font-size: 13px; }
.file .status { grid-column: 1 / -1; font-size: 13px; }
.file .status.ready { color: var(--ok); }
.file .status.missing { color: var(--warn); }
.file pre { grid-column: 1 / -1; margin-top: 6px; font-size: 13px; max-height: 340px; overflow: auto; padding-right: 16px; }
.files-bar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.note { font-size: 14px; color: var(--muted); }

.done-toggle { display: inline-flex; gap: 10px; align-items: center; margin-top: 16px; padding: 8px 14px; border: 1px solid var(--rule); border-radius: 8px; background: var(--surface); cursor: pointer; font-size: 15px; font-weight: 600; }
.done-toggle input { width: 18px; height: 18px; accent-color: var(--ok); }

.trouble dt { font-weight: 600; margin-top: 18px; }
.trouble dd { margin: 4px 0 0; max-width: 66ch; }
footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--rule); color: var(--muted); font-size: 14px; }

@media (max-width: 900px) {
  .wrap { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 24px 64px; }
  nav.rail { position: static; }
  .rail ol { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  h1 { font-size: 1.7rem; }
  body { font-size: 16px; }
  .file { grid-template-columns: minmax(0, 1fr); }
  .file .actions { justify-content: flex-start; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
</style>
</head>
